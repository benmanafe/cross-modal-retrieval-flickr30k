{
  "data": {
    "split_json": "D:\\BINUS\\Portfolio Projects\\CmRS-Flickr30k\\dataset_flickr30k.json",
    "image_dir": "D:\\BINUS\\Portfolio Projects\\CmRS-Flickr30k\\flickr30k_images",
    "cache_dir": "D:\\BINUS\\Portfolio Projects\\CmRS-Flickr30k\\flickr30k_cache",
    "cache_size": 256,
    "img_size": 224,
    "tokenizer": "sentence-transformers/all-MiniLM-L12-v2",
